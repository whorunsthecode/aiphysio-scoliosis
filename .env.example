# ─── Supabase (optional in development; required for cross-device persistence) ───
# Create a free project at https://supabase.com, copy from Settings → API.
# When unset, the app saves profiles + sessions to localStorage instead.
#
# !!! KEYS GO IN .env.local — NEVER IN THIS FILE.
# This file (.env.example) is committed to git as a template. Real values
# in .env.local are gitignored and stay on your machine.
#
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose. Used by /api routes that write to Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Groq (physio program parsing) ───
# Free tier at https://console.groq.com — Llama 3.3 70B in JSON mode.
# When unset, the parse-program endpoint returns a 503 with a clear message
# and the onboarding flow lets the user skip ahead.
GROQ_API_KEY=

# ─── Google Gemini (X-ray vision analysis) ───
# Free tier at https://aistudio.google.com/apikey — 1500 req/day on Gemini 2.0 Flash.
# When unset, the X-ray endpoint returns a 503 and onboarding lets the user skip.
GEMINI_API_KEY=

# ─── Multi-agent care team (Tier 1 + Tier 3) ───
# Telegram bot — required for the agents' user-facing channel.
# Create with @BotFather. Get chat ID by messaging the bot, then visiting
# https://api.telegram.org/bot<TOKEN>/getUpdates and copying message.chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cron auth secret — Vercel injects this on cron-triggered requests as a
# Bearer token. Generate any random string. Local dev bypasses if unset so
# you can run the analysis jobs by hand without it.
CRON_SECRET=

# Optional override for inter-function calls when not deployed on Vercel.
# Vercel sets VERCEL_URL automatically; locally Liaison falls back to this.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
